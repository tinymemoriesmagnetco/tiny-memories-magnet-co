
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiny-memories-magnet-co",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiny-memories-orders",
      "database_id": "9569e832-66c9-4708-b6b5-57ff4da3735e"
    }
  ],

  "r2_buckets": [
    {
      "binding": "VENDOR_PHOTOS",
      "bucket_name": "tiny-memories-vendor-photos"
    }
  ],

  "vars": {
    "PAYPAL_ENV": "live",
    "BLACK_FRIDAY_ENABLED": "true",
    "BLACK_FRIDAY_CODE": "BLACKFRIDAY",
    "BLACK_FRIDAY_START": "2026-11-27T08:00:00-05:00",
    "BLACK_FRIDAY_END": "2026-12-01T00:00:00-05:00"
  }
}
